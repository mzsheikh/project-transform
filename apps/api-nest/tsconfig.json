{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2019",
    "moduleResolution": "node",
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "jsx": "preserve"
  },
  "extends": "../../packages/contracts/tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
