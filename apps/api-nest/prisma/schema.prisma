// apps/api-nest/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  viewer
  editor
  admin
}

enum UserRole {
  user
  admin
}

enum AuthProvider {
  local
  google
  microsoft
}

enum FormStatus {
  draft
  published
  archived
}

enum SubmissionStatus {
  draft
  pending_sync
  submitted
  synced
  failed
}

enum ConnectorType {
  database
  rest_api
}

enum DatabaseProvider {
  postgresql
  mysql
  sqlserver
}

enum SubmitActionType {
  email_pdf
  database
  rest_api
}

enum ActionRunStatus {
  pending
  running
  success
  failed
  skipped
}

model App {
  appCode   String   @id @map("app_code")
  name      String
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  users       User[]
  groups      Group[]
  forms       Form[]
  submissions Submission[]
  connectors  Connector[]
  submitActions FormSubmitAction[]
  actionRuns SubmissionActionRun[]

  @@map("apps")
}

model AdminUser {
  id               String       @id @default(uuid()) @db.Uuid
  email            String       @unique
  role             AdminRole    @default(editor)
  isActive         Boolean      @default(true) @map("is_active")

  // Local login
  passwordHash     String?      @map("password_hash")

  // OAuth login (later)
  authProvider     AuthProvider @default(local) @map("auth_provider")
  providerUserId   String?      @map("provider_user_id")

  // Refresh rotation
  refreshTokenHash String?      @map("refresh_token_hash")
  refreshTokenExp  DateTime?    @map("refresh_token_exp")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([authProvider, providerUserId])
  @@map("admin_users")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  appCode      String   @map("app_code")
  username     String
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  createdAt    DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appCode], references: [appCode], onDelete: Cascade)

  groupMemberships GroupMember[]
  createdForms     Form[] @relation("FormCreatedBy")
  submissions      Submission[]

  @@unique([appCode, username])
  @@index([appCode, username])
  @@map("users")
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  appCode   String   @map("app_code")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appCode], references: [appCode], onDelete: Cascade)

  members GroupMember[]

  @@unique([appCode, name])
  @@index([appCode, name])
  @@map("groups")
}

model GroupMember {
  groupId String @map("group_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Form {
  id          String     @id @default(uuid()) @db.Uuid
  appCode     String     @map("app_code")
  formKey     String     @map("form_key")
  version     Int
  status      FormStatus @default(draft)
  title       String
  description String?
  schemaJson  Json       @map("schema_json")

  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appCode], references: [appCode], onDelete: Cascade)

  submitActions FormSubmitAction[]

  @@unique([appCode, formKey, version])
  @@index([appCode, formKey, status])
  @@map("forms")
}

model Submission {
  id         String           @id @default(uuid()) @db.Uuid
  appCode    String           @map("app_code")
  formKey    String           @map("form_key")
  formVersion Int             @map("form_version")

  userId     String?          @map("user_id") @db.Uuid
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  status     SubmissionStatus @default(draft)
  dataJson   Json             @default("{}") @map("data_json")

  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  app App @relation(fields: [appCode], references: [appCode], onDelete: Cascade)

  actionRuns SubmissionActionRun[]

  @@index([appCode, formKey, createdAt(sort: Desc)])
  @@map("submissions")
}

model Connector {
  id          String           @id @default(uuid()) @db.Uuid
  appCode     String           @map("app_code")
  name        String
  type        ConnectorType
  provider    DatabaseProvider?
  configJson  Json             @default("{}") @map("config_json")
  secretsJson Json?            @map("secrets_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appCode], references: [appCode], onDelete: Cascade)

  submitActions FormSubmitAction[]
  schemaSnapshots ConnectorSchemaSnapshot[]

  @@unique([appCode, name])
  @@index([appCode, type])
  @@map("connectors")
}

model FormSubmitAction {
  id         String           @id @default(uuid()) @db.Uuid
  appCode    String           @map("app_code")
  formId     String           @map("form_id") @db.Uuid
  formKey    String           @map("form_key")
  formVersion Int             @map("form_version")
  type       SubmitActionType
  name       String
  enabled    Boolean          @default(true)
  sortOrder  Int              @default(0) @map("sort_order")
  triggerKey String?          @map("trigger_key")
  connectorId String?         @map("connector_id") @db.Uuid
  configJson Json             @default("{}") @map("config_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app       App        @relation(fields: [appCode], references: [appCode], onDelete: Cascade)
  form      Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  connector Connector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  actionRuns SubmissionActionRun[]

  @@index([appCode, formKey, formVersion])
  @@index([formId, enabled, sortOrder])
  @@index([formId, triggerKey, enabled, sortOrder])
  @@map("form_submit_actions")
}

model SubmissionActionRun {
  id           String          @id @default(uuid()) @db.Uuid
  appCode      String          @map("app_code")
  submissionId String          @map("submission_id") @db.Uuid
  actionId     String?         @map("action_id") @db.Uuid
  actionType   SubmitActionType @map("action_type")
  actionName   String          @map("action_name")
  sortOrder    Int             @default(0) @map("sort_order")
  status       ActionRunStatus @default(pending)
  attemptCount Int             @default(0) @map("attempt_count")
  maxAttempts  Int             @default(3) @map("max_attempts")
  nextAttemptAt DateTime?      @map("next_attempt_at")
  lastAttemptAt DateTime?      @map("last_attempt_at")
  completedAt  DateTime?       @map("completed_at")
  actionSnapshot Json          @map("action_snapshot")
  responseJson Json?           @map("response_json")
  errorJson    Json?           @map("error_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app        App               @relation(fields: [appCode], references: [appCode], onDelete: Cascade)
  submission Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  action     FormSubmitAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([appCode, status, nextAttemptAt])
  @@index([submissionId, sortOrder])
  @@map("submission_action_runs")
}

model ConnectorSchemaSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  appCode     String   @map("app_code")
  connectorId String   @map("connector_id") @db.Uuid
  snapshotJson Json    @map("snapshot_json")
  createdAt   DateTime @default(now()) @map("created_at")

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([appCode, connectorId, createdAt(sort: Desc)])
  @@map("connector_schema_snapshots")
}
